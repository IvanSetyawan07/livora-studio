<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan rewrite file atau folder yang benar-benar ada (aset, llms.txt, ai-catalog.json, robots.txt, sitemap.xml)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback ke index.html
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Aset hasil build Vite sudah memiliki hash di nama file -> cache 1 tahun penuh
  <FilesMatch "\.(js|css|webp|woff2|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Gambar statis lain (favicon, og-livora) -> cache 30 hari
  <FilesMatch "\.(png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # index.html jangan di-cache lama supaya rilis terbaru langsung terbaca
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
